rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStaffOrAdmin() {
      return isAuthenticated() &&
        (
          getUserData().role == 'super_admin' ||
          getUserData().role == 'director' ||
          getUserData().role == 'editor' ||
          getUserData().role == 'editorial' ||
          getUserData().role == 'admin' ||
          request.auth.token.admin == true
        );
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    match /roles/{roleId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    match /issues/{issueId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    match /editorial_board/{memberId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }
    match /editorial_members/{memberId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isStaffOrAdmin();
    }

    match /submissions/{submissionId} {
      allow create: if true;
      allow read: if isStaffOrAdmin() ||
        (isAuthenticated() && resource.data.author_email == request.auth.token.email);
      allow update, delete: if isStaffOrAdmin();
    }

    match /books/{bookId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    match /shabdkosh/{shabdkoshId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }
    match /paheli/{paheliId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }
    match /lokgeet/{lokgeetId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }
    match /quiz_certificates/{certId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isStaffOrAdmin();
    }

    match /public_contributions/{contribId} {
      allow create: if true;
      allow read, update, delete: if isStaffOrAdmin();
    }

    match /activity_logs/{logId} {
      allow read, create: if isStaffOrAdmin();
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isStaffOrAdmin());
      allow write: if isStaffOrAdmin() ||
        (isAuthenticated() && request.auth.uid == userId &&
         request.resource.data.role == resource.data.role);
      allow create: if isStaffOrAdmin() ||
        (isAuthenticated() && request.auth.uid == userId &&
         (!('role' in request.resource.data) || request.resource.data.role == 'user'));
    }

    match /user_files/{fileId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.owner_uid == request.auth.uid;
      allow update, delete: if isStaffOrAdmin() ||
        (isAuthenticated() && resource.data.owner_uid == request.auth.uid);
    }
  }
}