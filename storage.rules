rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif|svg\\+xml)');
    }

    function isDocument() {
      return request.resource.contentType.matches('application/(pdf|msword|vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document|octet-stream|plain)');
    }

    function isAudioOrVideo() {
      return request.resource.contentType.matches('(audio|video)/.*');
    }

    function isStaffOrAdmin() {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in
          ['super_admin', 'director', 'editor', 'editorial', 'admin'];
    }

    match /users/{uid}/images/{fileName} {
      allow read: if true;
      allow write, create, update: if isImage() && request.resource.size <= 15 * 1024 * 1024
                                    && isAuthenticated() && request.auth.uid == uid;
      allow delete: if isAuthenticated() && request.auth.uid == uid;
    }

    match /users/{uid}/documents/{fileName} {
      allow read: if true;
      allow write, create, update: if (isDocument() || isImage()) && request.resource.size <= 35 * 1024 * 1024
                                    && isAuthenticated() && request.auth.uid == uid;
      allow delete: if isAuthenticated() && request.auth.uid == uid;
    }

    match /manuscripts/{fileName} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (isDocument() || isImage())
                             && request.resource.size <= 50 * 1024 * 1024;
      allow delete: if isStaffOrAdmin();
    }

    match /editorial_photos/{fileName} {
      allow read: if true;
      allow write, create, update: if isStaffOrAdmin() && isImage()
                                    && request.resource.size <= 20 * 1024 * 1024;
      allow delete: if isStaffOrAdmin();
    }

    match /documents/{fileName} {
      allow read: if true;
      allow write, create, update: if isStaffOrAdmin() && (isDocument() || isImage())
                                    && request.resource.size <= 50 * 1024 * 1024;
      allow delete: if isStaffOrAdmin();
    }

    match /books/{fileName} {
      allow read: if true;
      allow write, create, update: if isStaffOrAdmin() && (isDocument() || isImage())
                                    && request.resource.size <= 50 * 1024 * 1024;
      allow delete: if isStaffOrAdmin();
    }

    match /media/{fileName} {
      allow read: if true;
      allow write, create, update: if isStaffOrAdmin()
                                    && (isImage() || isAudioOrVideo() || isDocument())
                                    && request.resource.size <= 50 * 1024 * 1024;
      allow delete: if isStaffOrAdmin();
    }

    match /contributions/{fileName} {
      allow read: if true;
      allow create, update: if isAuthenticated() && request.resource.size <= 25 * 1024 * 1024;
      allow delete: if isStaffOrAdmin();
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.resource.size <= 35 * 1024 * 1024;
      allow delete: if isStaffOrAdmin();
    }
  }
}